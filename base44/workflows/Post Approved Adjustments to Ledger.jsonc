{
  "name": "Post Approved Adjustments to Ledger",
  "description": "Quando humano aprova ProposedAdjustment, gera journal_entry e marca Divergence como resolved.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProposedAdjustment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_approved_adjustments_to_ledger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recon/postApprovedAdjustment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recon/postApprovedAdjustment"
  }
}