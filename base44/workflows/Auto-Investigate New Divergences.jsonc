{
  "name": "Auto-Investigate New Divergences",
  "description": "Quando uma nova Divergence \u00e9 criada com status='detected', dispara automaticamente o agente Investigador IA.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"detected\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Divergence"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_investigate_new_divergences",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recon/triggerInvestigator",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recon/triggerInvestigator"
  }
}