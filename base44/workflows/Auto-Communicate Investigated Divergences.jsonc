{
  "name": "Auto-Communicate Investigated Divergences",
  "description": "Quando Investigador conclui (status passa para 'investigated'), aciona Communicator.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"investigated\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Divergence"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_communicate_investigated_divergences",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recon/triggerCommunicator",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recon/triggerCommunicator"
  }
}